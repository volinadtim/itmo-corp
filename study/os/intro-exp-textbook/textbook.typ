  [Стоимость вершины], [6 системных вызовов + 3 операции с диском ≈ 340 мкс], [обращение к памяти — наносекунды],
  [Стоимость страницы], [170 × 3 = 510 операций с диском], [1 промах (+1 на первую запись), диск — раз на ≈12 страниц],
  [Запись на диск], [на каждой вершине, блоком 512 Б], [один раз в конце, `msync`, весь файл],
  [10M целиком], [≈ 1,3 млн операций с диском], [≈ 208 чтений пачками + запись файла],
)

