    line((x(135), 0), (x(187), 0), stroke: grey, mark: (end: ">"))
    for v in (140, 150, 160, 170, 180) {
      line((x(v), -0.1), (x(v), 0.1), stroke: grey)
      content((x(v), -0.4), text(size: 8pt)[#v])
    }
    for v in (153.3, 182.9, 140.6, 148.1, 140.8, 150.1, 168.7, 157.8, 141.0, 140.9) {
