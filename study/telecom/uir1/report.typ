// ---------- временная диаграмма ----------
#let wave(levels, bits, three: false, unit: 0.5, h: 0.55, label: none) = {
  let n = bits.len()
  cetz.canvas(length: 1cm, {
    import cetz.draw: *
    let W = n * unit
    let y(l) = l * h
    // сетка битовых интервалов
    for i in range(n + 1) {
      line((i * unit, -h - 0.15), (i * unit, h + 0.15), stroke: (paint: luma(170), thickness: 0.4pt, dash: "dashed"))
    }
    for i in range(n) {
      content(((i + 0.5) * unit, h + 0.42), text(size: 7.5pt, fill: if bits.at(i) == 1 { blue } else { red.darken(20%) }, str(bits.at(i))))
    }
    line((0, 0), (W, 0), stroke: (paint: luma(200), thickness: 0.4pt))
    // сам сигнал
    let pts = ()
    for (j, l) in levels.enumerate() {
      let x0 = j * unit / 2
      let x1 = (j + 1) * unit / 2
      pts.push((x0, y(l)))
      pts.push((x1, y(l)))
    }
    line(..pts, stroke: 1.1pt + black)
    if label != none {
      content((-0.25, 0), anchor: "east", text(size: 9pt, weight: "bold", label))
    }
    content((W + 0.12, y(1)), anchor: "west", text(size: 7pt, "+U"))
    if three { content((W + 0.12, 0), anchor: "west", text(size: 7pt, "0")) }
    content((W + 0.12, y(-1)), anchor: "west", text(size: 7pt, "−U"))
  })
}

