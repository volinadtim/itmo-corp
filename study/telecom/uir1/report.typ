    caption: caption,
  )
}

// ---------- расчёт частот: таблица и формулы ----------
#let freq-calc(r, Cx, name, bits-total) = {
  let rows = r.rows
  [Битовый интервал $t_b = 1 slash C = #fmt(1000 / Cx)$~нс. Разобьём сигнал на участки постоянного уровня. Участок длительностью $k dot t_b$ — это полупериод гармоники с частотой $f = 1 / (2 k t_b) = C / (2k)$.]
  figure(
    table(
      columns: 5,
      table.header([Длительность участка, $k dot t_b$], [Частота $f_i = C\/(2k)$, МГц], [Число участков $n_i$], [Суммарная длительность $n_i k$, $t_b$], [$f_i dot n_i k$]),
      ..rows.map(x => (
        [#fmt(x.k)], [#fmt(x.f)], [#x.n], [#fmt(x.t)], [#fmt(x.f * x.t)],
      )).flatten(),
      [*Σ*], [], [#rows.map(x => x.n).sum()], [#fmt(r.total_t)], [#fmt(rows.map(x => x.f * x.t).sum())],
    ),
    caption: [Частотный состав сигнала #name при $C = #fmt(Cx)$~Мбит/с],
  )
  let fv-k = rows.first().k
  let fn-k = rows.last().k
  [
    - Верхняя граница частот (самый короткий участок, $k = #fmt(fv-k)$): $f_"в" = C / (2 dot #fmt(fv-k)) = #fmt(r.fv)$~МГц.
    - Нижняя граница частот (самый длинный участок, $k = #fmt(fn-k)$): $f_"н" = C / (2 dot #fmt(fn-k)) = #fmt(r.fn)$~МГц.
    - Спектр сигнала: $S = f_"в" - f_"н" = #fmt(r.fv) - #fmt(r.fn) = #fmt(r.S)$~МГц.
    - Средняя частота (среднее, взвешенное по времени): $f_"ср" = (sum f_i n_i k_i) / (sum n_i k_i) = #fmt(rows.map(x => x.f * x.t).sum()) / #fmt(r.total_t) = #fmt(r.favg)$~МГц.
    - Полоса пропускания: $F >= S = #fmt(r.S)$~МГц, то есть канал должен пропускать частоты от #mhz(r.fn) до #mhz(r.fv). Если оставить запас на 3-ю гармонику самой быстрой составляющей (для надёжного распознавания, слайд 34), верхняя граница поднимается до $3 f_"в" = #fmt(r.F3)$~МГц, а полоса — до $F = #fmt(r.F3 - r.fn)$~МГц.
  ]
}

