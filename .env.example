# Скопируй в .env и заполни:
#   cp .env.example .env

# Логин my.itmo.ru (Keycloak / ITMO ID — обычно email)
MY_ITMO_EMAIL=

# Пароль ITMO ID
MY_ITMO_PASSWORD=

# ИСУ (для справки агенту, не используется при логине)
MY_ITMO_ISU=368086

# Опционально: ключ шифрования сессии agent-browser
# AGENT_BROWSER_ENCRYPTION_KEY=
